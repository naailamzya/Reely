<?xml version="1.0" encoding="utf-8"?>
<resources>

    //Default Dark Theme
    <style name="Theme.Reely.NightCinema" parent="Theme.Material3.Dark.NoActionBar">

        <item name="colorPrimary">@color/night_accent_primary</item>
        <item name="colorPrimaryVariant">@color/night_accent_secondary</item>
        <item name="colorOnPrimary">@color/night_bg_primary</item>

        <item name="colorSecondary">@color/night_accent_teal</item>
        <item name="colorSecondaryVariant">@color/night_accent_secondary</item>
        <item name="colorOnSecondary">@color/night_bg_primary</item>

        <item name="android:colorBackground">@color/night_bg_primary</item>
        <item name="colorSurface">@color/night_bg_card</item>
        <item name="colorOnBackground">@color/night_text_primary</item>
        <item name="colorOnSurface">@color/night_text_primary</item>

        <item name="android:statusBarColor">@color/night_bg_primary</item>
        <item name="android:navigationBarColor">@color/night_nav_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowBackground">@color/night_bg_primary</item>
        <item name="android:windowIsTranslucent">false</item>

        <item name="android:textColorPrimary">@color/night_text_primary</item>
        <item name="android:textColorSecondary">@color/night_text_secondary</item>
        <item name="android:textColorHint">@color/night_text_hint</item>

        <item name="materialCardViewStyle">@style/Widget.Reely.CardView.Night</item>
        <item name="bottomNavigationStyle">@style/Widget.Reely.BottomNav.Night</item>

    </style>


    //Light Mode
    <style name="Theme.Reely.SoftCinema" parent="Theme.Material3.Light.NoActionBar">

        <item name="colorPrimary">@color/soft_accent_primary</item>
        <item name="colorPrimaryVariant">@color/soft_accent_secondary</item>
        <item name="colorOnPrimary">@color/soft_bg_primary</item>

        <item name="colorSecondary">@color/soft_accent_teal</item>
        <item name="colorSecondaryVariant">@color/soft_accent_secondary</item>
        <item name="colorOnSecondary">@color/soft_bg_primary</item>

        <item name="android:colorBackground">@color/soft_bg_primary</item>
        <item name="colorSurface">@color/soft_bg_card</item>
        <item name="colorOnBackground">@color/soft_text_primary</item>
        <item name="colorOnSurface">@color/soft_text_primary</item>

        <item name="android:statusBarColor">@color/soft_bg_primary</item>
        <item name="android:navigationBarColor">@color/soft_nav_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:windowBackground">@color/soft_bg_primary</item>

        <item name="android:textColorPrimary">@color/soft_text_primary</item>
        <item name="android:textColorSecondary">@color/soft_text_secondary</item>
        <item name="android:textColorHint">@color/soft_text_hint</item>

        <item name="materialCardViewStyle">@style/Widget.Reely.CardView.Soft</item>
        <item name="bottomNavigationStyle">@style/Widget.Reely.BottomNav.Soft</item>

    </style>

    // Splash Screen
    <style name="Theme.Reely.Splash" parent="Theme.Reely.NightCinema">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/night_bg_primary</item>
        <item name="android:statusBarColor">@color/night_bg_primary</item>
        <item name="android:navigationBarColor">@color/night_bg_primary</item>
    </style>

    // Card
    <style name="Widget.Reely.CardView.Night" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/night_bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/night_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Reely.CardView.Soft" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/soft_bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/soft_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    // Bottom Navigation
    <style name="Widget.Reely.BottomNav.Night" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/night_nav_background</item>
        <item name="itemIconTint">@color/night_nav_unselected</item>
        <item name="itemTextColor">@color/night_nav_unselected</item>
        <item name="itemActiveIndicatorColor">@color/night_bg_surface</item>
    </style>

    <style name="Widget.Reely.BottomNav.Soft" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/soft_nav_background</item>
        <item name="itemIconTint">@color/soft_nav_unselected</item>
        <item name="itemTextColor">@color/soft_nav_unselected</item>
        <item name="itemActiveIndicatorColor">@color/soft_bg_surface</item>
    </style>

    // Text
    <style name="TextStyle.Reely.HeroTitle">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">@color/night_text_primary</item>
    </style>

    <style name="TextStyle.Reely.SectionLabel">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextStyle.Reely.CardTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TextStyle.Reely.Rating">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/rating_star</item>
    </style>

</resources>