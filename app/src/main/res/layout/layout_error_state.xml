<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingVertical="48dp"
    android:paddingHorizontal="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📡"
        android:textSize="52sp" />

    <TextView
        android:id="@+id/tvErrorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/error_no_internet"
        android:textSize="17sp"
        android:textColor="@color/night_text_primary"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="16dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvErrorSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/error_no_internet_subtitle"
        android:textSize="13sp"
        android:textColor="@color/night_text_secondary"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetry"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:text="@string/btn_retry"
        android:textSize="13sp"
        android:textColor="@color/night_bg_primary"
        android:paddingHorizontal="28dp"
        app:backgroundTint="@color/night_accent_primary"
        app:cornerRadius="100dp"
        app:icon="@drawable/ic_refresh"
        app:iconTint="@color/night_bg_primary"
        app:iconSize="16dp" />

</LinearLayout>