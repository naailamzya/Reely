<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- ── Header ── -->
    <LinearLayout
        android:id="@+id/layoutDiscoverHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:background="@color/color_background"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discover"
            android:textSize="28sp"
            android:textColor="@color/color_on_background"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find your next favorite film"
            android:textSize="13sp"
            android:textColor="@color/color_text_secondary"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Search bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search movies..."
            app:boxStrokeColor="@color/color_stroke"
            app:boxStrokeWidthFocused="2dp"
            app:boxBackgroundColor="@color/color_surface"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintTextColor="@color/color_text_hint"
            app:startIconDrawable="@drawable/ic_refresh"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_on_surface"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- ── Filter Row ── -->
    <LinearLayout
        android:id="@+id/layoutFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/color_background"
        android:paddingTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutDiscoverHeader">

        <!-- Genre chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupGenre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true" />

        </HorizontalScrollView>

        <!-- Sort row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/tvResultCount"
                android:text="All Movies"
                android:textSize="13sp"
                android:textColor="@color/color_text_secondary" />

            <!-- Sort by: Popularity -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortPopularity"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🔥 Popular"
                android:textSize="11sp"
                android:layout_marginEnd="6dp"
                app:backgroundTint="@color/color_primary"
                app:cornerRadius="100dp" />

            <!-- Sort by: Rating -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSortRating"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="⭐ Rating"
                android:textSize="11sp"
                app:strokeColor="@color/color_stroke"
                app:cornerRadius="100dp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/color_stroke"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- ── Results / States ── -->

    <!-- Loading first page -->
    <ProgressBar
        android:id="@+id/progressDiscover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/color_primary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutFilters"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Error state -->
    <include
        android:id="@+id/layoutDiscoverError"
        layout="@layout/layout_error_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutFilters"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutFilters"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No movies found"
            android:textSize="16sp"
            android:textColor="@color/color_on_background"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try a different genre or search term"
            android:textSize="13sp"
            android:textColor="@color/color_text_secondary"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- Movie grid + Load More -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollDiscover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutFilters"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDiscover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />

            <!-- Loading more -->
            <ProgressBar
                android:id="@+id/progressLoadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="12dp"
                android:indeterminateTint="@color/color_primary"
                android:visibility="gone" />

            <!-- Load More button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoadMore"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:layout_marginVertical="8dp"
                android:text="Load More"
                android:textSize="13sp"
                android:textColor="@color/color_on_primary"
                android:paddingHorizontal="32dp"
                android:visibility="gone"
                app:backgroundTint="@color/color_primary"
                app:cornerRadius="100dp" />

            <TextView
                android:id="@+id/tvEndOfList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="You've seen it all ✨"
                android:textSize="13sp"
                android:textColor="@color/color_text_hint"
                android:layout_marginVertical="20dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
