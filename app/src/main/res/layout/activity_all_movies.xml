<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_background"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_background"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/color_on_background" />

        <!-- Category title -->
        <TextView
            android:id="@+id/tvCategoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Now Playing"
            android:textSize="@dimen/text_headline_lg"
            android:textColor="@color/color_on_background"
            android:fontFamily="@font/poppins"
            android:textStyle="bold"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingBottom="@dimen/spacing_md" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Movie grid RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAllMovies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingTop="@dimen/spacing_sm"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false" />

            <!-- Loading more indicator -->
            <ProgressBar
                android:id="@+id/progressLoadMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="@dimen/spacing_md"
                android:indeterminateTint="@color/color_primary"
                android:visibility="gone" />

            <!-- Load More button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoadMore"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="Load More"
                android:textSize="@dimen/text_body_sm"
                android:textColor="@color/color_on_primary"
                android:paddingHorizontal="@dimen/spacing_xl"
                android:fontFamily="@font/poppins"
                android:visibility="gone"
                app:backgroundTint="@color/color_primary"
                app:cornerRadius="@dimen/radius_pill" />

            <!-- End of list message -->
            <TextView
                android:id="@+id/tvEndOfList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="You've seen it all ✨"
                android:textSize="@dimen/text_body_sm"
                android:textColor="@color/color_text_hint"
                android:fontFamily="@font/poppins"
                android:layout_marginVertical="@dimen/spacing_lg"
                android:visibility="gone" />

            <!-- Error state -->
            <include
                android:id="@+id/layoutError"
                layout="@layout/layout_error_state"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>