<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_bg_primary">

    <!-- ── Collapsing Toolbar with Backdrop ── -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@color/night_bg_primary"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/night_bg_primary"
            app:expandedTitleMarginBottom="120dp"
            app:titleEnabled="false">

            <!-- Backdrop image -->
            <ImageView
                android:id="@+id/ivDetailBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/content_description_backdrop"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.7" />

            <!-- Gradient overlay bottom -->
            <!-- Toolbar with back button -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarDetail"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/night_text_primary" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ── Scrollable Content ── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- Loading state -->
            <ProgressBar
                android:id="@+id/progressDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="48dp"
                android:indeterminateTint="@color/night_accent_primary"
                android:visibility="gone" />

            <!-- Error state -->
            <include
                android:id="@+id/layoutDetailError"
                layout="@layout/layout_error_state"
                android:visibility="gone" />

            <!-- ── Poster + Title row ── -->
            <LinearLayout
                android:id="@+id/layoutDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:visibility="gone">

                <!-- Poster -->
                <androidx.cardview.widget.CardView
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp">

                    <ImageView
                        android:id="@+id/ivDetailPoster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/content_description_movie_poster" />

                </androidx.cardview.widget.CardView>

                <!-- Title + meta -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Movie Title"
                        android:textSize="20sp"
                        android:textColor="@color/night_text_primary"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingMultiplier="1.2" />

                    <!-- Rating row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/tvDetailRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★ 8.5"
                            android:textSize="14sp"
                            android:textColor="@color/rating_star"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvDetailVoteCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(2.5k)"
                            android:textSize="12sp"
                            android:textColor="@color/night_text_hint"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                    <!-- Release date -->
                    <TextView
                        android:id="@+id/tvDetailReleaseDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2024"
                        android:textSize="12sp"
                        android:textColor="@color/night_text_secondary"
                        android:layout_marginTop="4dp" />

                    <!-- Runtime -->
                    <TextView
                        android:id="@+id/tvDetailRuntime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2h 28m"
                        android:textSize="12sp"
                        android:textColor="@color/night_text_secondary"
                        android:layout_marginTop="2dp" />

                    <!-- Genre chips row -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:id="@+id/layoutGenreChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                </LinearLayout>

            </LinearLayout>

            <!-- ── Tagline ── -->
            <TextView
                android:id="@+id/tvDetailTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:textStyle="italic"
                android:textColor="@color/night_accent_primary"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/night_stroke"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp" />

            <!-- ── Overview section ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_overview"
                android:textSize="14sp"
                android:letterSpacing="0.1"
                android:textColor="@color/night_text_primary"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvDetailOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Overview text..."
                android:textSize="14sp"
                android:textColor="@color/night_text_secondary"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.6" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom: Add to Watchlist button (floating) ── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddWatchlist"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:text="@string/detail_add_watchlist"
        android:textSize="14sp"
        android:textColor="@color/night_bg_primary"
        app:backgroundTint="@color/night_accent_primary"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_bookmark_outline"
        app:iconTint="@color/night_bg_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>