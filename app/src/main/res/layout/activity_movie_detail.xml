<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- Collapsing Toolbar + Backdrop -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@color/color_background"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/color_background"
            app:titleEnabled="false">

            <ImageView
                android:id="@+id/ivDetailBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/content_description_backdrop"
                app:layout_collapseMode="parallax" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarDetail"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:navigationIconTint="@color/color_on_background" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/progressDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="48dp"
                android:indeterminateTint="@color/color_primary"
                android:visibility="gone" />

            <!-- Error -->
            <include
                android:id="@+id/layoutDetailError"
                layout="@layout/layout_error_state"
                android:visibility="gone" />

            <!-- ══════════════════════════════════════ -->
            <!--   POSTER + TITLE ROW                  -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:visibility="gone">

                <!-- Poster -->
                <androidx.cardview.widget.CardView
                    android:layout_width="110dp"
                    android:layout_height="165dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp">

                    <ImageView
                        android:id="@+id/ivDetailPoster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/content_description_movie_poster" />

                </androidx.cardview.widget.CardView>

                <!-- Title + Meta -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textColor="@color/color_on_background"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingMultiplier="1.2" />

                    <!-- Rating -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/tvDetailRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="@color/rating_star"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/tvDetailVoteCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/color_text_hint"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <!-- Release + Runtime -->
                    <TextView
                        android:id="@+id/tvDetailReleaseDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/color_text_secondary"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvDetailRuntime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/color_text_secondary"
                        android:layout_marginTop="2dp" />

                    <!-- Genre chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="10dp">

                        <LinearLayout
                            android:id="@+id/layoutGenreChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                </LinearLayout>
            </LinearLayout>

            <!-- ══════════════════════════════════════ -->
            <!--   BUDGET + REVENUE INFO               -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutBudgetRevenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:visibility="gone">

                <!-- Budget -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@color/color_surface"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Budget"
                        android:textSize="11sp"
                        android:textColor="@color/color_text_hint"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tvDetailBudget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/color_on_surface"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <View
                    android:layout_width="8dp"
                    android:layout_height="match_parent" />

                <!-- Revenue -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@color/color_surface"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Revenue"
                        android:textSize="11sp"
                        android:textColor="@color/color_text_hint"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tvDetailRevenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/color_on_surface"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- ══════════════════════════════════════ -->
            <!--   TAGLINE                             -->
            <!-- ══════════════════════════════════════ -->
            <TextView
                android:id="@+id/tvDetailTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="italic"
                android:textColor="@color/color_primary"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/color_stroke"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp" />

            <!-- ══════════════════════════════════════ -->
            <!--   OVERVIEW                            -->
            <!-- ══════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overview"
                android:textSize="15sp"
                android:letterSpacing="0.05"
                android:textColor="@color/color_on_background"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/tvDetailOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/color_text_secondary"
                android:paddingHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.6" />

            <!-- ══════════════════════════════════════ -->
            <!--   TRAILER                             -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutTrailerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_stroke"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trailer"
                    android:textSize="15sp"
                    android:textColor="@color/color_on_background"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="20dp"
                    android:layout_marginTop="20dp" />

                <!-- Trailer thumbnail — tap buka YouTube -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTrailer"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Thumbnail -->
                        <ImageView
                            android:id="@+id/ivTrailerThumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="Trailer thumbnail" />

                        <!-- Dark overlay -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#66000000" />

                        <!-- Play button -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:text="▶"
                                android:textSize="28sp"
                                android:textColor="#FFFFFF"
                                android:gravity="center"
                                android:background="@color/color_surface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Watch Trailer"
                                android:textSize="13sp"
                                android:textColor="#FFFFFF"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>

                    </FrameLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ══════════════════════════════════════ -->
            <!--   CAST                                -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutCastSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/color_stroke"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cast"
                    android:textSize="15sp"
                    android:textColor="@color/color_on_background"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="20dp"
                    android:layout_marginTop="20dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="14dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

            <!-- ══════════════════════════════════════ -->
            <!--   CREW                                -->
            <!-- ══════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/layoutCrewSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crew"
                    android:textSize="15sp"
                    android:textColor="@color/color_on_background"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="20dp"
                    android:layout_marginTop="20dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCrew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="14dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Add to Watchlist button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddWatchlist"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:text="@string/detail_add_watchlist"
        android:textSize="14sp"
        android:textColor="@color/color_on_primary"
        app:backgroundTint="@color/color_primary"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_bookmark_outline"
        app:iconTint="@color/color_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>