<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_bg_primary">

    <View
        android:id="@+id/viewGradientBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash_gradient" />

    <LinearLayout
        android:id="@+id/layoutLogoGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="REELY Logo" />

        <TextView
            android:id="@+id/tvSplashAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REELY"
            android:textSize="42sp"
            android:letterSpacing="0.3"
            android:textColor="@color/night_text_primary"
            android:fontFamily="sans-serif-thin"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_tagline"
            android:textSize="13sp"
            android:letterSpacing="0.15"
            android:textColor="@color/night_text_secondary"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressSplash"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/night_accent_primary"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="64dp" />

</androidx.constraintlayout.widget.ConstraintLayout>