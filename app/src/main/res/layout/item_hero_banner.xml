<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivHeroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/content_description_backdrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvHeroLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_hero_label"
            android:textSize="10sp"
            android:letterSpacing="0.1"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:fontFamily="@font/poppins"
            android:textStyle="bold"
            android:background="@drawable/bg_hero_label_badge"
            android:backgroundTint="@color/color_primary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvHeroTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movie Title"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/poppins"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="-4dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutHeroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHeroRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★ 8.5"
                android:textSize="14sp"
                android:textColor="@color/rating_star"
                android:fontFamily="@font/poppins"
                android:textStyle="bold" />

            <View
                android:layout_width="4dp"
                android:layout_height="4dp"
                android:background="@drawable/shape_dot"
                android:backgroundTint="#80FFFFFF"
                android:layout_marginHorizontal="8dp" />

            <TextView
                android:id="@+id/tvHeroYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2024"
                android:textSize="14sp"
                android:textColor="#B3FFFFFF"
                android:fontFamily="@font/poppins" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>