<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerHome"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.3"
    app:shimmer_highlight_alpha="0.9"
    app:shimmer_angle="0"
    app:shimmer_duration="1200">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@color/night_bg_surface" />

        <View
            android:layout_width="140dp"
            android:layout_height="14dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_shimmer_rounded"
            android:backgroundTint="@color/night_bg_surface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="14dp">

            <include layout="@layout/item_shimmer_movie_card" />
            <include layout="@layout/item_shimmer_movie_card" />
            <include layout="@layout/item_shimmer_movie_card" />

        </LinearLayout>

        <View
            android:layout_width="160dp"
            android:layout_height="14dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_shimmer_rounded"
            android:backgroundTint="@color/night_bg_surface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:paddingHorizontal="14dp">

            <include layout="@layout/item_shimmer_movie_card" />
            <include layout="@layout/item_shimmer_movie_card" />
            <include layout="@layout/item_shimmer_movie_card" />

        </LinearLayout>

    </LinearLayout>

</com.facebook.shimmer.ShimmerFrameLayout>