<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- HERO BANNER SECTION - IMMERSIVE CINEMATIC LOOK -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="520dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHeroBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never" />

                <!-- Transparent Header/Greeting with Status Bar Padding -->
                <RelativeLayout
                    android:id="@+id/layoutGreeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/screen_margin"
                    android:paddingTop="48dp"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentStart="true">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Good Evening,"
                            android:textSize="13sp"
                            android:textColor="#B3FFFFFF"
                            android:fontFamily="@font/poppins"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/tvUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="User"
                            android:textSize="26sp"
                            android:textColor="#FFFFFF"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold" />
                    </LinearLayout>

                </RelativeLayout>
            </FrameLayout>

            <include
                android:id="@+id/layoutErrorState"
                layout="@layout/layout_error_state"
                android:visibility="gone" />

            <include
                android:id="@+id/layoutShimmer"
                layout="@layout/layout_shimmer_home"
                android:visibility="gone" />

            <!-- MAIN CONTENT SHEET -->
            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="-40dp"
                android:background="@drawable/bg_content_sheet"
                android:paddingTop="32dp">

                <!-- Now Playing Section -->
                <LinearLayout
                    android:id="@+id/sectionNowPlaying"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/screen_margin"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvTitleNowPlaying"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_section_nowplaying"
                            android:textSize="22sp"
                            android:textColor="@color/color_on_background"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@id/tvSeeAllNowPlaying" />

                        <TextView
                            android:id="@+id/tvSeeAllNowPlaying"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="@string/home_see_all"
                            android:textSize="13sp"
                            android:textColor="@color/color_primary"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold"
                            android:layout_marginStart="16dp" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvNowPlaying"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />
                </LinearLayout>

                <!-- Trending Section -->
                <LinearLayout
                    android:id="@+id/sectionTrending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="40dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/screen_margin"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvTitleTrending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_section_trending"
                            android:textSize="22sp"
                            android:textColor="@color/color_on_background"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@id/tvSeeAllTrending" />

                        <TextView
                            android:id="@+id/tvSeeAllTrending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="@string/home_see_all"
                            android:textSize="13sp"
                            android:textColor="@color/color_primary"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold"
                            android:layout_marginStart="16dp" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTrending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />
                </LinearLayout>

                <!-- Upcoming Section -->
                <LinearLayout
                    android:id="@+id/sectionUpcoming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="40dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/screen_margin"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvTitleUpcoming"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_section_upcoming"
                            android:textSize="22sp"
                            android:textColor="@color/color_on_background"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@id/tvSeeAllUpcoming" />

                        <TextView
                            android:id="@+id/tvSeeAllUpcoming"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="@string/home_see_all"
                            android:textSize="13sp"
                            android:textColor="@color/color_primary"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold"
                            android:layout_marginStart="16dp" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvUpcoming"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />
                </LinearLayout>

                <!-- Top Rated Section -->
                <LinearLayout
                    android:id="@+id/sectionTopRated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="40dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/screen_margin"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvTitleTopRated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_section_toprated"
                            android:textSize="22sp"
                            android:textColor="@color/color_on_background"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@id/tvSeeAllTopRated" />

                        <TextView
                            android:id="@+id/tvSeeAllTopRated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="@string/home_see_all"
                            android:textSize="13sp"
                            android:textColor="@color/color_primary"
                            android:fontFamily="@font/poppins"
                            android:textStyle="bold"
                            android:layout_marginStart="16dp" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTopRated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>